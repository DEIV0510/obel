# Copia este archivo como .env.local (desarrollo) o define las variables en
# Vercel → Project → Settings → Environment Variables. Nunca subas claves reales.

# ── Públicas (se incluyen en el código del navegador) ─────────────────────
# Dominio definitivo, sin barra final. Activa canonical, sitemap y URLs absolutas.
# En Vercel, si se deja vacío, se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# Solo si cambia el WhatsApp comercial (el oficial ya está en config/sitio.ts).
NEXT_PUBLIC_WHATSAPP=

# ── Privadas: envío del formulario de prediagnóstico (solo servidor) ─────
# Sin ninguno de los dos canales, el formulario NO da la solicitud por
# recibida: informa que el envío no está habilitado y ofrece WhatsApp.

# Canal 1 · Correo con Resend (https://resend.com). Guía completa en el README.
# Clave de la API (en Vercel, márcala como «Sensitive»)
RESEND_API_KEY=
# Uno o varios correos que reciben las solicitudes, separados por coma
CONTACTO_CORREO_DESTINO=
# Opcional. Remitente de un dominio verificado en Resend, p. ej.:
#   OBEL Colombia <web@tudominio.com>
# Si se deja vacío se usa el remitente de prueba onboarding@resend.dev, que
# SOLO entrega en el correo con el que se creó la cuenta de Resend.
CONTACTO_CORREO_REMITENTE=

# Canal 2 · Webhook (CRM, Google Apps Script, Make, Zapier…). Recibe un POST JSON.
FORMULARIO_WEBHOOK_URL=
# Opcional: se envía en la cabecera X-Obel-Secreto para validar el origen
FORMULARIO_WEBHOOK_SECRETO=
